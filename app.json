{
  "expo": {
    "name": "MonkeyFi",
    "slug": "monkeyfi",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "monkeyfi",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0E7C3A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mf.madrazzo.monkeyfi"
    },
    "android": {
      "package": "mf.madrazzo.monkeyfi"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
